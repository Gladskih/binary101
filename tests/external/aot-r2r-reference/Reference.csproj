<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NativeFormatOnly)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_FORMAT_ONLY</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(NativeFormatOnly)' == 'true'">
    <Compile Remove="*.cs" />
    <Compile Include="NativeFormatReference.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <!-- Source directories contain unmodified dotnet/runtime v10.0.0 reader files.
       Supply them with -p:NativeFormatSourceDirectory=... -p:ReadyToRunSourceDirectory=... .
       The reference executable is a developer test tool, never a browser dependency. -->
  <ItemGroup>
    <Compile Include="$(NativeFormatSourceDirectory)/MdBinaryReader*.cs" />
    <Compile Include="$(NativeFormatSourceDirectory)/NativeFormat*.cs" />
    <Compile Include="$(NativeFormatSourceDirectory)/NativeMetadataReader.cs" />
    <Compile Include="$(NativeFormatSourceDirectory)/DehydratedData.cs" />
  </ItemGroup>
  <!-- NativeFormatOnly also accepts unmodified v9.0.0 metadata reader sources.
       Runtime map tools use the v10 NativeLayout definitions and are omitted in this mode. -->
  <ItemGroup Condition="'$(NativeFormatOnly)' != 'true'">
    <Compile Include="$(ReadyToRunSourceDirectory)/NativeReader.cs" />
    <Compile Include="$(ReadyToRunSourceDirectory)/NativeArray.cs" />
    <Compile Include="$(ReadyToRunSourceDirectory)/NativeHashtable.cs" />
    <Compile Include="$(ReadyToRunSourceDirectory)/PEReaderExtensions.cs" />
    <Compile Include="$(ReadyToRunSourceDirectory)/ReadyToRunConstants.cs" />
    <Compile Include="$(ReadyToRunSourceDirectory)/ModuleHeaders.cs" />
    <Compile Include="$(ReadyToRunSourceDirectory)/RuntimeConstants.cs" />
  </ItemGroup>
  <Target Name="RequireUpstreamSources" BeforeTargets="BeforeBuild">
    <Error Condition="'$(NativeFormatSourceDirectory)' == ''"
      Text="Supply NativeFormatSourceDirectory with upstream .NET metadata reader sources." />
    <Error Condition="'$(NativeFormatOnly)' != 'true' and '$(ReadyToRunSourceDirectory)' == ''"
      Text="Supply ReadyToRunSourceDirectory with .NET v10.0.0 runtime reader sources." />
  </Target>
</Project>
